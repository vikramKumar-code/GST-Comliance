PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/gstapp
FRONTEND_URL=http://localhost:5173
USE_MOCK=true
DATA_ENCRYPTION_KEY=
JWT_SECRET=
TENANT_IDENTITY_SECRET=
SESSION_HOURS=1
TRUST_PROXY_HOPS=0
CONTACT_INTAKE_ENABLED=
PROVIDER=
TAXPRO_BASE_URL=
TAXPRO_ASPID=
# TaxPro ASP secret/password is Base64-encoded AES key material for GetKey sessions.
TAXPRO_PASSWORD=
# Caller GSTIN must be registered to the ASP account.
TAXPRO_ASP_GSTIN=
# Absolute path to the registered RSA private key in PEM format; keep it outside the repository.
TAXPRO_ASP_PRIVATE_KEY_PATH=
TAXPRO_ASP_PRIVATE_KEY_PASSPHRASE=
TAXPRO_GSP_IP_USR=
TAXPRO_APP_VERSION=CandidTax/1.0
TAXPRO_API_PROFILE=
TAXPRO_GSTR1_ACTION_REQUIRED=
# The adapter implements only the decrypted /dec/ transport. TaxPro has not approved /dec/ for production.
# Production startup refuses unless explicitly approved by the human operator after written confirmation from TaxPro.
TAXPRO_DEC_PRODUCTION_APPROVED=
# Subscription Payment
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_key_here
