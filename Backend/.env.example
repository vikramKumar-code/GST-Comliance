# ===========================================================================
# SERVER & RUNTIME CONFIGURATION
# ===========================================================================
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/gstapp
FRONTEND_URL=http://localhost:5173
EXTRA_CORS_ORIGINS=
HTTP_BODY_LIMIT=10mb
HTTP_PARAMETER_LIMIT=5000
GST_REQUEST_TIMEOUT_MS=120000
ENABLE_APP_SHUTDOWN_HANDLERS=true
SESSION_HOURS=6
TRUST_PROXY_HOPS=0
CONTACT_INTAKE_ENABLED=false

# ===========================================================================
# SECURITY & CRYPTOGRAPHY SECRETS
# ===========================================================================
DATA_ENCRYPTION_KEY=REPLACE_WITH_HEX_64_CHAR_KEY
JWT_SECRET=REPLACE_WITH_HEX_64_CHAR_KEY
TENANT_IDENTITY_SECRET=REPLACE_WITH_HEX_64_CHAR_KEY

# ===========================================================================
# GST RETURN FILING / FEATURE FLAGS
# ===========================================================================
PROVIDER=taxpro
USE_MOCK=false
FEATURE_FILING=true
ALLOW_DEV_LIVE_FILING=true
ALLOW_DEMO_SEED=false
DEMO_SEED_ALLOWED_ENVS=development,test
TEST_GSTIN=29AABCU9603R1ZM

# ===========================================================================
# TAXPRO GSP / ASP CREDENTIALS & SETTINGS
# ===========================================================================
TAXPRO_BASE_URL=https://gstapi.charteredinfo.com
TAXPRO_ASPID=YOUR_TAXPRO_ASPID
TAXPRO_PASSWORD=YOUR_TAXPRO_PASSWORD
TAXPRO_GSP_SECRET=YOUR_TAXPRO_GSP_SECRET
TAXPRO_GSP_IP_USR=YOUR_WHITELISTED_IP
TAXPRO_ASP_GSTIN=YOUR_ASP_GSTIN
# Absolute path to registered RSA private key in PEM format
TAXPRO_ASP_PRIVATE_KEY_PATH=C:/TaxProCert/AspDsc_matching.pem
TAXPRO_ASP_PRIVATE_KEY_PASSPHRASE=
TAXPRO_APP_VERSION=CandidTax/1.0
TAXPRO_API_PROFILE=legacy
TAXPRO_GSTR1_ACTION_REQUIRED=
# Pre-file step: enforce 'retsubmit' instead of 'proceed' for stable GSTR-1 freezing
TAXPRO_GSTR1_PRE_FILE_STEP=proceed
# Pin deterministic EVC signature mode
TAXPRO_EVC_ENCODING=
TAXPRO_EVC_SIGN_MODE=
TAXPRO_EVC_SIGN_OVER=
TAXPRO_TOKEN_TTL_MINUTES=330
TAXPRO_FILE_TIMEOUT_MS=60000
TAXPRO_PERIOD_PLACEMENT=query
TAXPRO_DEC_PRODUCTION_APPROVED=true
TAXPRO_ALLOW_NIL_SUMMARY_FALLBACK=false

# ===========================================================================
# E-INVOICE & THIRD-PARTY INTEGRATIONS (Active / Future)
# ===========================================================================
TAXPRO_EINV_USER=YOUR_EINV_USERNAME
TAXPRO_EINV_PASSWORD=YOUR_EINV_PASSWORD
TAXPRO_EINV_GSTIN=YOUR_EINV_GSTIN
FINAGG_BASE_URL=
FINAGG_API_KEY=
ALLOW_MOCK_IN_PRODUCTION=false

# ===========================================================================
# SUBSCRIPTION & PAYMENT (Razorpay)
# ===========================================================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_key_here
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_FEE_RATE=0.02
GST_ON_FEE_RATE=0.18
COMPANY_BANK_ACCOUNT_MASKED=
COMPANY_BANK_NAME=

# ===========================================================================
# PLATFORM ADMIN & AUTHENTICATION
# ===========================================================================
SUPER_ADMIN_EMAILS=admin@example.com
GOOGLE_CLIENT_ID=

# ===========================================================================
# ROUTE RATE LIMITING & SAFETY TIMEOUTS
# ===========================================================================
ROUTE_RATE_LIMIT_ENABLED=true
ROUTE_RATE_LIMIT_SKIP_NON_PROD=false
ROUTE_RATE_LIMIT_LOG_DENIED=true
RATE_LIMIT_DEBUG_HEADER=

GST_FILING_ROUTE_TIMEOUT_MS=120000
GST_SAVE_ROUTE_TIMEOUT_MS=90000
GST_MAX_EXCLUDED_INVOICE_IDS=5000
GST_FILING_POLL_TRIES=15
GST_FILING_POLL_DELAY_MS=2000
GST_VALIDATE_STRICT_BODY=false
GST_TZ_OFFSET_MIN=330

GST_SAVE_RATE_WINDOW_MS=900000
GST_FILING_RATE_WINDOW_MS=900000
GST_EVC_RATE_WINDOW_MS=600000
GST_NIL_RATE_WINDOW_MS=900000
GST_DEMO_RATE_WINDOW_MS=3600000

GST_SAVE_RATE_MAX=20
GST_FILING_RATE_MAX=10
GST_EVC_RATE_MAX=5
GST_NIL_RATE_MAX=5
GST_DEMO_RATE_MAX=0

# ===========================================================================
# GST RETURN DATA & LOGIC SETTINGS (Derived from Codebase)
# ===========================================================================
GSTIN_CACHE_TTL_HOURS=6
GSTIN_SEARCH_MAX_PER_MIN=30
GSTN_CHECKSUM_FORMAT=json
GSTN_DEFAULT_UQC=PCS
GSTN_DOC_NUM_MAX=1000000
GSTN_DOC_TYP_INV=Invoices for outward supply
GSTN_DOC_TYP_CN=Credit Note
GSTN_DOC_TYP_DN=Debit Note
GSTN_DOC_TYP_ENUM=
GSTN_UQC_ENUM=
GSTN_HSN_ALLOW_NEGATIVE=true
GSTN_HSN_DESC_MAX=30
GST_ACTIVE_DOCUMENT_STATUSES=
GST_ENABLE_LOCAL_RETURN_SYNTHESIS=true
GST_GSTR1_B2CL_THRESHOLD=250000
GST_GSTR1_SANITIZE_INUM=false
GST_GSTR1_TREAT_EXCLUDED_AS_CANCELLED=true
GST_3B_ALLOW_NEGATIVE_VALUES=false
GST_3B_CLAMP_NEGATIVE_ITC=true
GST_NIL_REQUIRE_PORTAL_CONFIRMATION=true
GST_NIL_GSTR1_PRE_FILE_STEP=proceed
GST_NIL_POLL_ATTEMPTS=12
GST_NIL_POLL_DELAY_MS=3000
GST_NIL_SUMMARY_SETTLE_MS=2000
GST_NIL_USE_FULL_VALIDATOR=false
GST_NIL_1_INCLUDE_TABLE8=false
GST_NIL_3B_ALLOW_ZERO_ITC_BILLS=false
