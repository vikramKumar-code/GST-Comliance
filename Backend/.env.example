PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/gstapp
FRONTEND_URL=http://localhost:5173
USE_MOCK=true
FEATURE_FILING=false
DATA_ENCRYPTION_KEY=
JWT_SECRET=
TENANT_IDENTITY_SECRET=
SESSION_HOURS=1
TRUST_PROXY_HOPS=0
CONTACT_INTAKE_ENABLED=
PROVIDER=
TAXPRO_BASE_URL=
TAXPRO_ASPID=
# TaxPro ASP secret/password is Base64-encoded AES key material for GetKey sessions.
TAXPRO_PASSWORD=
# Caller GSTIN must be registered to the ASP account.
TAXPRO_ASP_GSTIN=
# Absolute path to the registered RSA private key in PEM format; keep it outside the repository.
TAXPRO_ASP_PRIVATE_KEY_PATH=
TAXPRO_ASP_PRIVATE_KEY_PASSPHRASE=
TAXPRO_GSP_IP_USR=
TAXPRO_APP_VERSION=CandidTax/1.0
# Explicitly select "legacy" or "current" after confirming the corresponding TaxPro API contract.
TAXPRO_API_PROFILE=legacy
# Required only when TAXPRO_API_PROFILE=current.
TAXPRO_GSTR1_ACTION_REQUIRED=
# GSTR-1 Pre-File Step: 'retsubmit' (recommended) or 'proceed'
TAXPRO_GSTR1_PRE_FILE_STEP=retsubmit
# Pin deterministic EVC signature mode ('std', 'raw', 'single_b64key', 'double', 'raw_b64key')
TAXPRO_EVC_ENCODING=std
# Token TTL in minutes (330 mins = 5.5 hours, avoids unnecessary hourly REFRESHTOKEN calls)
TAXPRO_TOKEN_TTL_MINUTES=330
# The adapter implements only the decrypted /dec/ transport. TaxPro has not approved /dec/ for production.
# Production startup refuses unless explicitly approved by the human operator after written confirmation from TaxPro.
TAXPRO_DEC_PRODUCTION_APPROVED=
# Live Filing Controls: Set FEATURE_FILING=true to allow live portal uploads.
# In development (NODE_ENV=development), ALLOW_DEV_LIVE_FILING=true must also be set.
FEATURE_FILING=false
ALLOW_DEV_LIVE_FILING=false
# Subscription Payment
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_key_here
